# Mini WhatsApp Bot Environment Variables
BOT_NAME=MiniBot
OWNER_NAME=Owner
OWNER_NUMBERS=923116469820
PREFIX=.
PORT=8080
SESSION_DIR=./auth_info_baileys
VIEWONCE_MODE=dm

# Optional: Security Mode ('public', 'groups', or 'self')
# 'public' = All chats active
# 'groups' = Groups & owner DM only (ignores stranger DMs)
# 'self'   = Only responds to owner (0% ban risk)
BOT_MODE=public

# Optional: Set your phone number here to auto-generate pairing code in console on cloud hosts (e.g. KataBump)
# PAIRING_NUMBER=923056499820

